# Caddy reverse proxy.
#
# SERVER_DOMAIN controls the site address:
#   • a real domain  → automatic HTTPS (Let's Encrypt).
#   • empty          → defaults to ":80" (plain HTTP on the server IP), so the panel
#     is reachable at http://<ip> right after install. You then enter your domain in
#     the panel → it reloads Caddy via the admin API → HTTPS turns on automatically.
#
# Routing (same in both modes):
#   /api/*  /health  /docs  /openapi.json → backend:8000
#   everything else                        → frontend (static SPA)

{
	admin 0.0.0.0:2019
	email {$ACME_EMAIL}
	# No HTTP/3: the SNI TLS-passthrough relay in front of Caddy forwards TCP only, so an
	# advertised h3 alt-svc points browsers at a dead UDP path (they cache it for 30 days
	# and waste QUIC attempts before falling back). Advertise only what is reachable.
	servers {
		protocols h1 h2
	}
}

{$SERVER_DOMAIN::80} {
	# Scoped to the SPA only, never /api/*: Caddy's encode rewrites a compressed response's ETag by
	# appending "-gzip"/"-zstd" (RFC-correct — each encoding is a distinct representation), but the
	# storefront portal's If-Match concurrency token is a bare "sf-config-N" string compared for exact
	# equality server-side. A compressed settings/plans/managers response handed the mangled ETag
	# straight back as the next request's If-Match, which the backend then rejected as malformed —
	# breaking nearly every save in the storefront admin portal (2026-08-31).
	@api path /api/* /health /docs /openapi.json
	handle @api {
		reverse_proxy backend:8000
	}
	handle {
		encode zstd gzip
		reverse_proxy frontend:80
	}
}
